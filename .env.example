# ==========================================
# BramTech VTU - Environment Variables
# Copy this file to .env and fill in real values
# ==========================================

# Django Core
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database (PostgreSQL)
POSTGRES_DB=bramtech_vtu
POSTGRES_USER=bramtech
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://bramtech:change-this-password@postgres:5432/bramtech_vtu

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Security
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Payment Gateway (Monnify) - fill in later
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_BASE_URL=https://sandbox.monnify.com

# VTU Aggregators - fill in later
PAIRGATE_API_KEY=
PAIRGATE_BASE_URL=https://api.pairgate.com

VTUNG_USERNAME=
VTUNG_PASSWORD=
VTUNG_PIN=
VTUNG_BASE_URL=https://vtu.ng/wp-json/api/v1

# Email (Resend) - fill in later
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=noreply@bramtechvtu.com

# SMS (Termii) - fill in later
TERMII_API_KEY=
TERMII_SENDER_ID=BramTech

# Sentry - fill in later
SENTRY_DSN=